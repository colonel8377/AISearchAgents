# API Settings
API_HOST=0.0.0.0
API_PORT=8000

# Authentication Settings (Optional)
API_KEY_REQUIRED=false
# Comma-separated list of valid API keys (e.g., API_KEYS=key1,key2,key3)
API_KEYS=

# LLM Settings (OpenAI-compatible API for Qwen or OpenAI)
OPENAI_API_KEY=your_api_key_here
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-3.5-turbo
# Optional: HTTP proxy for API requests (DEPRECATED - use HTTP_PROXY/HTTPS_PROXY environment variables instead)
# OPENAI_PROXY is deprecated and will be ignored. Use standard HTTP_PROXY and HTTPS_PROXY instead.
OPENAI_PROXY=
# API retry and timeout settings
OPENAI_MAX_RETRIES=3  # Number of retries for failed API calls
OPENAI_TIMEOUT=60.0   # Timeout in seconds for API requests

# Embedding Settings
EMBEDDING_PROVIDER=openai  # Options: openai, qwen, gemini, deepseek
EMBEDDING_MODEL=text-embedding-ada-002
# Embedding API credentials (leave empty to use OPENAI_* settings)
EMBEDDING_API_KEY=
EMBEDDING_API_BASE=
EMBEDDING_PROXY=


# Proxy Configuration (recommended approach)
# To use a proxy, set these standard environment variables:
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1

# Performance Optimization Settings
# Set USE_OPTIMIZED_MODE=false to disable all optimizations (legacy mode)
USE_OPTIMIZED_MODE=true           # Enable/disable optimized mode with chain caching and connection pooling
USE_CHAIN_CACHE=true              # Enable/disable chain caching (only applies if USE_OPTIMIZED_MODE=true)
USE_SHARED_HTTP_CLIENT=true       # Enable/disable shared HTTP client (only applies if USE_OPTIMIZED_MODE=true)
# HTTP connection pool settings (only applies if USE_OPTIMIZED_MODE=true and USE_SHARED_HTTP_CLIENT=true)
OPENAI_MAX_CONNECTIONS=100              # Maximum number of HTTP connections in pool
OPENAI_MAX_KEEPALIVE_CONNECTIONS=20     # Maximum number of keep-alive connections
OPENAI_KEEPALIVE_EXPIRY=30.0            # Keep-alive connection expiry time in seconds

# Task Execution Mode (can be overridden per-request via API)
# Options: chain_online, chain_local, no_chain
# - chain_online: LLM does all chaining and reasoning (most autonomous)
# - chain_local: We decompose tasks into subtasks locally (best balance, recommended)
# - no_chain: Pure prompt, no task decomposition (simplest, fastest)
DEFAULT_EXECUTION_MODE=chain_local

# Vector Store Settings
VECTOR_STORE_TYPE=chroma  # Options: redis, postgres, chroma

# Redis Settings (if using Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# PostgreSQL Settings (if using PostgreSQL with pgvector)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=vectordb

# Chroma Settings (if using Chroma)
CHROMA_PERSIST_DIRECTORY=../data/chroma_db

# Agent Settings
AGENT_MAX_TURNS=4
AGENT_TEMPERATURE=0.7

# Conversation Summarization Settings
MAX_CONVERSATION_LENGTH=50
MAX_TOKENS_PER_MESSAGE=500

# Chat History Mode Settings
DEFAULT_HISTORY_MODE=full              # full (maintain history) or none (stateless)
SMART_MEMORY_ENABLED=true             # Enable smart memory for user preferences/opinions

# Logging Settings
LOG_LEVEL=INFO  # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE=../logs/ai_search_agents.log
ENABLE_DEBUG=false

CACHE_BACKEND=redis
CACHE_DB_PATH=../../data/agent_cache.db
CACHE_REDIS_DB=2