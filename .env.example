# API Settings
API_HOST=0.0.0.0
API_PORT=8000

# Authentication Settings (Optional)
API_KEY_REQUIRED=false
# Comma-separated list of valid API keys (e.g., API_KEYS=key1,key2,key3)
API_KEYS=

# LLM Settings (OpenAI-compatible API for Qwen or OpenAI)
OPENAI_API_KEY=your_api_key_here
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-3.5-turbo

# Vector Store Settings
VECTOR_STORE_TYPE=chroma  # Options: redis, postgres, chroma

# Redis Settings (if using Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# PostgreSQL Settings (if using PostgreSQL with pgvector)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=vectordb

# Chroma Settings (if using Chroma)
CHROMA_PERSIST_DIRECTORY=./chroma_db

# Agent Settings
AGENT_MAX_TURNS=4
AGENT_TEMPERATURE=0.7

# Conversation Summarization Settings
MAX_CONVERSATION_LENGTH=50
MAX_TOKENS_PER_MESSAGE=500
